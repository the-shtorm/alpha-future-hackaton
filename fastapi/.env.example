ML_INTERNAL_API_KEY=REPLACE_WITH_RANDOM_SECRET
MODEL_VARIANT=finetuned
MODEL_PATH=hf://thedauns/e5-credit-finetune-v1@e93f86ce54f0a6d2b3da24dac803e50ee92bbb2b/model
# Alternatives: MODEL_PATH=C:/models/e5 or MODEL_PATH=s3://bucket/prefix
HF_CACHE_DIR=models/hf-cache
HF_LOCAL_FILES_ONLY=false
HF_TOKEN=
S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Identity and revision are pinned in config/finetuned-model.lock.json.
ENVIRONMENT=production
DOCS_ENABLED=false
PORT=8000
EMBEDDING_BATCH_SIZE=4
TORCH_NUM_THREADS=2
TORCH_NUM_INTEROP_THREADS=1
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false
PASSAGE_CACHE_MAX_ENTRIES=512
# Empty uses the pinned provisional synthetic calibration; set to override it.
RECOMMENDATION_MAX_COSINE_DISTANCE=
MAX_INFLIGHT_RANK_REQUESTS=4
ADMISSION_TIMEOUT_SECONDS=1
MAX_REQUEST_BYTES=524288
LOG_LEVEL=INFO
SCORING_ENABLED=false
SCORING_MODEL_PATH=thedauns/sba-scoring-v2
# Alternatives: hf://namespace/repo@<commit-SHA>/model or C:/models/scoring
