      "Product": {
        "allOf": [
          {
            "if": {
              "anyOf": [
                {
                  "properties": {
                    "collateralRequirement": {
                      "const": "CONDITIONAL"
                    }
                  },
                  "required": [
                    "collateralRequirement"
                  ]
                },
                {
                  "properties": {
                    "guarantorRequirement": {
                      "const": "CONDITIONAL"
                    }
                  },
                  "required": [
                    "guarantorRequirement"
                  ]
                }
              ]
            },
            "then": {
              "properties": {
                "securityNote": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "securityNote"
              ]
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Id"
          },
          "version": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Version"
          },
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Name"
          },
          "type": {
            "type": "string",
            "enum": [
              "TERM_LOAN",
              "REVOLVING_CREDIT_LINE",
              "NON_REVOLVING_CREDIT_LINE",
              "OVERDRAFT"
            ],
            "title": "Type"
          },
          "purposes": {
            "items": {
              "type": "string",
              "enum": [
                "WORKING_CAPITAL",
                "CASH_GAP",
                "EQUIPMENT",
                "TRANSPORT",
                "COMMERCIAL_PROPERTY",
                "CONTRACT_EXECUTION",
                "REFINANCING",
                "DEVELOPMENT"
              ]
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "uniqueItems": true,
            "title": "Purposes"
          },
          "usageModes": {
            "items": {
              "type": "string",
              "enum": [
                "ONE_TIME",
                "IN_PARTS",
                "ACCOUNT_RESERVE"
              ]
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "uniqueItems": true,
            "title": "Usagemodes"
          },
          "targetScenario": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Targetscenario"
          },
          "targetSectors": {
            "items": {
              "type": "string",
              "enum": [
                "TRADE",
                "MANUFACTURING",
                "SERVICES",
                "AGRICULTURE",
                "CONSTRUCTION",
                "TRANSPORT",
                "IT",
                "HOSPITALITY"
              ]
            },
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "title": "Targetsectors"
          },
          "specialization": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Specialization"
          },
          "collateralRequirement": {
            "type": "string",
            "enum": [
              "NONE",
              "REQUIRED",
              "CONDITIONAL"
            ],
            "title": "Collateralrequirement"
          },
          "guarantorRequirement": {
            "type": "string",
            "enum": [
              "NONE",
              "REQUIRED",
              "CONDITIONAL"
            ],
            "title": "Guarantorrequirement"
          },
          "securityNote": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Securitynote"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "version",
          "name",
          "type",
          "purposes",
          "usageModes",
          "targetScenario",
          "collateralRequirement",
          "guarantorRequirement"
        ],
        "title": "Product"
      },
