                },
                {
                  "properties": {
                    "guarantorRequirement": {
                      "const": "CONDITIONAL"
                    }
                  },
                  "required": [
                    "guarantorRequirement"
                  ]
                }
              ]
            },
            "then": {
              "properties": {
                "securityNote": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "securityNote"
              ]
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "version": {
            "type": "string",
            "format": "uuid",
            "title": "Version"
          },
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Name"
