        "type": "object",
        "required": [
          "id",
          "version",
          "name",
          "type",
          "purposes",
          "usageModes",
          "targetScenario",
          "collateralRequirement",
          "guarantorRequirement",
          "code",
          "synthetic"
        ],
        "title": "JavaProduct"
      },
      "JavaRankRequest": {
        "properties": {
          "schemaVersion": {
            "type": "string",
