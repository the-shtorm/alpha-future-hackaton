            "title": "Collateralrequirement"
          },
          "guarantorRequirement": {
            "type": "string",
            "enum": [
              "NONE",
              "REQUIRED",
              "CONDITIONAL"
            ],
            "title": "Guarantorrequirement"
          },
          "securityNote": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Securitynote"
          },
          "code": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Code"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic"
          }
