            "title": "Type"
          },
          "purposes": {
            "items": {
              "type": "string",
              "enum": [
                "WORKING_CAPITAL",
                "CASH_GAP",
                "EQUIPMENT",
                "TRANSPORT",
                "COMMERCIAL_PROPERTY",
                "CONTRACT_EXECUTION",
                "REFINANCING",
                "DEVELOPMENT"
              ]
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "uniqueItems": true,
            "title": "Purposes"
          },
          "usageModes": {
            "items": {
              "type": "string",
              "enum": [
                "ONE_TIME",
                "IN_PARTS",
                "ACCOUNT_RESERVE"
              ]
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "uniqueItems": true,
            "title": "Usagemodes"
          },
          "targetScenario": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Targetscenario"
          },
          "targetSectors": {
            "items": {
              "type": "string",
              "enum": [
                "TRADE",
                "MANUFACTURING",
                "SERVICES",
                "IT",
                "CONSTRUCTION",
                "AGRICULTURE",
                "LOGISTICS"
              ]
            },
            "type": "array",
            "maxItems": 7,
            "uniqueItems": true,
            "title": "Targetsectors"
          },
          "specialization": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
