      "JavaProduct": {
        "allOf": [
          {
            "if": {
              "anyOf": [
                {
                  "properties": {
                    "collateralRequirement": {
                      "const": "CONDITIONAL"
                    }
                  },
                  "required": [
                    "collateralRequirement"
