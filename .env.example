POSTGRES_DB=credit_cabinet
POSTGRES_PORT=5432
POSTGRES_ADMIN_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_APP_PASSWORD=
SPRING_PROFILES_ACTIVE=demo
BACKEND_PORT=8080
FASTAPI_PORT=8000
# Generated by scripts/setup-demo; creates the customer demo account.
DEMO_PASSWORD=
# Generated by scripts/setup-demo; creates the bank demo account.
DEMO_BANK_PASSWORD=
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=

# Historical 2.1 revisions only; new revisions always use the SBA policy.
DEMO_ASSESSMENT_ENABLED=false

# Local frontend port; API is available through /api on the same origin.
FRONTEND_PORT=3000
# Local HTTP only. Set true behind HTTPS in deployed environments.
SESSION_COOKIE_SECURE=false

# Internal Java-compatible ranking endpoint; replace the key with a random secret.
RECSYS_URL=http://fastapi:8000/api/v1/recommendations/rank-java
RECSYS_API_KEY=
RECSYS_TIMEOUT_MS=10000
RECSYS_MODEL_VARIANT=finetuned
MODEL_PATH=hf://thedauns/e5-credit-finetune-v1@e93f86ce54f0a6d2b3da24dac803e50ee92bbb2b/model
# Docker local alternative: MODEL_PATH=/models/e5-credit-finetune-v1/final
# Host folder fastapi/models is mounted at /models; S3 alternative: s3://bucket/prefix
HF_LOCAL_FILES_ONLY=false
HF_HUB_DISABLE_XET=true
HF_TOKEN=
S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Empty uses the policy pinned to RECSYS_MODEL_VARIANT (synthetic calibration).
# Override after independent calibration and label review.
# Cosine distance = 1 - similarity, valid range [0, 2].
RECOMMENDATION_MAX_COSINE_DISTANCE=

# Trained demonstration SBA package; standalone FastAPI remains disabled by default.
SCORING_ENABLED=true
SCORING_MODEL_PATH=thedauns/sba-scoring-v2
# Alternatives: hf://namespace/repo@<commit-SHA>/model or /scoring-models/custom-scoring
SCORING_URL=http://fastapi:8000/api/v1/scoring/evaluate
# Compose uses RECSYS_API_KEY for both internal services; never put the key in frontend code.
